{
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "coverageDirectory": "../coverage",
    "coveragePathIgnorePatterns": [
        "node_modules",
        "preview-template",
        "build-templates",
        "profiles"
    ],
    "transform": {
        "^.+\\.tsx?$": [
            "ts-jest",
            {
                "tsconfig": "tsconfig.test.json"
            }
        ]
    },
    "testPathIgnorePatterns": [
        "/node_modules/",
        "/integration-tests/"
    ],
    "testMatch": [
        "**/?(*.)+(spec|test).+(ts)"
    ],
    "testResultsProcessor": "jest-sonar-reporter",
    "coverageReporters": [
        "cobertura",
        "text-summary",
        "text",
        "lcov"
    ],
    "setupFiles": [
        "<rootDir>/tests/cocos-testing/reflect-metadata.ts",
        "<rootDir>/tests/cocos-testing/mobx.ts"
    ],
    "reporters": [
        "default",
        [
            "jest-junit",
            {
                "outputDirectory": "../reports"
            }
        ]
    ],
    "verbose": true,
    "moduleNameMapper": {
        "cc": "<rootDir>/tests/cocos-testing/cc",
        "^observer": "<rootDir>/tests/cocos-testing/observer",
        "inversify": "<rootDir>/tests/cocos-testing/inversify",
        "db://assets/(.*)": "<rootDir>/assets/$1",
        "db://shared-components/(.*)": "<rootDir>/extensions/shared-components/assets/$1",
        "db://shared-cascading-slot/(.*)": "<rootDir>/extensions/shared-cascading-slot/assets/$1",
        "db://shared-common-slot/(.*)": "<rootDir>/extensions/shared-common-slot/assets/$1",
        "db://i18n/(.*)": "<rootDir>/extensions/i18n/assets/$1",
        "socket.io-client/dist/socket.io.msgpack.min.js": "socket.io-client/dist/socket.io.js"
    },
    "maxWorkers": 10
}